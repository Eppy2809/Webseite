CONTACT_ORIGIN=https://valtro-webdesign.de
# Internal gateway of the Docker network used by the Caddy container.
CONTACT_HOST=172.18.0.1
CONTACT_PORT=8787
CONTACT_TO=kontakt@valtro.cloud

# Zugangsdaten des vorhandenen E-Mail-Postfachs. Diese Datei darf nie in Git landen.
CONTACT_SMTP_HOST=smtp.hostinger.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=kontakt@valtro.cloud
CONTACT_SMTP_PASSWORD=CHANGE_ME
CONTACT_SMTP_FROM=kontakt@valtro.cloud

# Auf dem Server mit "openssl rand -hex 32" erzeugen.
CONTACT_IP_HASH_KEY=CHANGE_ME
CONTACT_QUEUE_MAX_AGE=604800
CONTACT_RATE_LIMIT=5

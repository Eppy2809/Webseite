# Replace the existing Valtro-Webdesign blocks in the server Caddyfile with these blocks.
www.valtro-webdesign.de {
    redir https://valtro-webdesign.de{uri} permanent
}

valtro-webdesign.de {
    encode gzip

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' 'sha256-B3ZYr/NSp5dLXf01tmpZqnoqX145a72evVLFHlBG7UM=' 'sha256-g26nXTYukYaHd+tGWyKhAjLfRulnpyDk3dA+si2STjo='; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
    }

    route {
        @private path /.git* /deploy/* /server/* /README.md /package.json /package-lock.json /.gitignore
        respond @private 404

        handle /api/contact {
            request_body {
                max_size 32KB
            }
            reverse_proxy 172.18.0.1:8787 {
                header_up X-Real-IP {remote_host}
            }
        }

        handle {
            root * /srv/valtro-webdesign
            file_server {
                hide .git
            }
        }
    }
}
